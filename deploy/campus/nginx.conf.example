# CinemaHOT 校园部署模板。替换域名、证书路径、校园 CIDR 后再启用。
# 192.0.2.0/24 是文档示例；不是学校网段。详见 docs/deployment/campus.md。
# Docker 网页端口须设置 PORT=127.0.0.1:3000，应用设置 TRUST_PROXY=true。
server {
    listen 443 ssl;
    server_name cinemahot.example.edu;

    ssl_certificate     /etc/nginx/tls/cinemahot.crt;
    ssl_certificate_key /etc/nginx/tls/cinemahot.key;

    allow 192.0.2.0/24;
    deny all;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_buffering off;
        # 保留应用 Cache-Control，不额外缓存后台或延长公开内容缓存期限。
    }
}
